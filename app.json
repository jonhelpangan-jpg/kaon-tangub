{
  "expo": {
    "name": "Kaon Tangub",
    "slug": "kaon-tangub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.kaontangub"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E30613",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.example.kaontangub"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "scheme": "kaontangub",
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Kaon Tangub uses your location to set your delivery pin within Tangub City."
        }
      ]
    ]
  }
}
